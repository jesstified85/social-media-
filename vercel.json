{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/linktree/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://linktr.ee"
        }
      ]
    }
  ]
}
